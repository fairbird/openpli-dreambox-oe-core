From 9b7aabea11b45519b8539319a93cb42e6d010f63 Mon Sep 17 00:00:00 2001
From: fairbird <rrrr53@hotmail.com>
Date: Mon, 15 Dec 2025 17:48:36 +0300
Subject: [PATCH] support python 3.14

-----

 nodedownload.py | 26 +++++++++++++++-----------
 1 file changed, 15 insertions(+), 11 deletions(-)

diff --git a/tools/configure.d/nodedownload.py b/tools/configure.d/nodedownload.py
index 4f144e0..fa2a386 100644
--- a/tools/configure.d/nodedownload.py
+++ b/tools/configure.d/nodedownload.py
@@ -7,10 +7,7 @@ import sys
 import zipfile
 import tarfile
 import contextlib
-try:
-    from urllib.request import FancyURLopener, URLopener
-except ImportError:
-    from urllib import FancyURLopener, URLopener
+from urllib.request import urlopen, Request
 
 def formatSize(amt):
     """Format a size as a string in MB"""
@@ -21,11 +18,6 @@ def spin(c):
     spin = ".:|'"
     return (spin[c % len(spin)])
 
-class ConfigOpener(FancyURLopener):
-    """fancy opener used by retrievefile. Set a UA"""
-    # append to existing version (UA)
-    version = '%s node.js/configure' % URLopener.version
-
 def reporthook(count, size, total):
     """internal hook used by retrievefile"""
     sys.stdout.write(' Fetch: %c %sMB total, %sMB downloaded   \r' %
@@ -38,8 +30,20 @@ def retrievefile(url, targetfile):
     try:
         sys.stdout.write(' <%s>\nConnecting...\r' % url)
         sys.stdout.flush()
-        ConfigOpener().retrieve(url, targetfile, reporthook=reporthook)
-        print('')  # clear the line
+        req = Request(url, headers={'User-Agent': 'node.js/configure'})
+        with urlopen(req) as r, open(targetfile, 'wb') as f:
+            total = r.length or 0
+            blocksize = 8192
+            count = 0
+            while True:
+                block = r.read(blocksize)
+                if not block:
+                    break
+                f.write(block)
+                count += 1
+                if total:
+                    reporthook(count, blocksize, total)
+        print('')
         return targetfile
     except IOError as err:
         print(' ** IOError %s\n' % err)
