From: fairbird <rrrr53@hotmail.com>
Date: Mon, 16 Mar 2026 00:00:00 +0000
Subject: [PATCH] fix: add gl2ext.h include and KHR fallback defines in GLUtils.cpp

GL_DEBUG_SOURCE_*_KHR, GL_DEBUG_TYPE_*_KHR and GL_DEBUG_SEVERITY_*_KHR
are defined by GL_KHR_debug in <GLES2/gl2ext.h>. When the sysroot's
gl2ext.h is missing or outdated these tokens are undefined, failing
the build under HAS_GLES. Fix by including gl2ext.h under HAS_GLES
and adding #ifndef-guarded fallbacks matching the official KHR spec
values (numerically identical to core GL equivalents per the spec).
---
 xbmc/utils/GLUtils.cpp | 38 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/xbmc/utils/GLUtils.cpp b/xbmc/utils/GLUtils.cpp
--- a/xbmc/utils/GLUtils.cpp
+++ b/xbmc/utils/GLUtils.cpp
@@ -19,6 +19,65 @@
 #include "utils/StringUtils.h"
 
 #include <stdexcept>
+
+#ifdef HAS_GLES
+#include <GLES2/gl2ext.h>
+/* Fallback defines for GL_KHR_debug tokens absent from older gl2ext.h.
+   Values are from the Khronos GL_KHR_debug extension specification and
+   are numerically identical to the corresponding core GL 4.3 tokens. */
+#ifndef GL_DEBUG_SOURCE_API_KHR
+#  define GL_DEBUG_SOURCE_API_KHR                  0x8246
+#endif
+#ifndef GL_DEBUG_SOURCE_WINDOW_SYSTEM_KHR
+#  define GL_DEBUG_SOURCE_WINDOW_SYSTEM_KHR        0x8247
+#endif
+#ifndef GL_DEBUG_SOURCE_SHADER_COMPILER_KHR
+#  define GL_DEBUG_SOURCE_SHADER_COMPILER_KHR      0x8248
+#endif
+#ifndef GL_DEBUG_SOURCE_THIRD_PARTY_KHR
+#  define GL_DEBUG_SOURCE_THIRD_PARTY_KHR          0x8249
+#endif
+#ifndef GL_DEBUG_SOURCE_APPLICATION_KHR
+#  define GL_DEBUG_SOURCE_APPLICATION_KHR          0x824A
+#endif
+#ifndef GL_DEBUG_SOURCE_OTHER_KHR
+#  define GL_DEBUG_SOURCE_OTHER_KHR                0x824B
+#endif
+#ifndef GL_DEBUG_TYPE_ERROR_KHR
+#  define GL_DEBUG_TYPE_ERROR_KHR                  0x824C
+#endif
+#ifndef GL_DEBUG_TYPE_DEPRECATED_BEHAVIOR_KHR
+#  define GL_DEBUG_TYPE_DEPRECATED_BEHAVIOR_KHR    0x824D
+#endif
+#ifndef GL_DEBUG_TYPE_UNDEFINED_BEHAVIOR_KHR
+#  define GL_DEBUG_TYPE_UNDEFINED_BEHAVIOR_KHR     0x824E
+#endif
+#ifndef GL_DEBUG_TYPE_PORTABILITY_KHR
+#  define GL_DEBUG_TYPE_PORTABILITY_KHR            0x824F
+#endif
+#ifndef GL_DEBUG_TYPE_PERFORMANCE_KHR
+#  define GL_DEBUG_TYPE_PERFORMANCE_KHR            0x8250
+#endif
+#ifndef GL_DEBUG_TYPE_OTHER_KHR
+#  define GL_DEBUG_TYPE_OTHER_KHR                  0x8251
+#endif
+#ifndef GL_DEBUG_TYPE_MARKER_KHR
+#  define GL_DEBUG_TYPE_MARKER_KHR                 0x8268
+#endif
+#ifndef GL_DEBUG_SEVERITY_HIGH_KHR
+#  define GL_DEBUG_SEVERITY_HIGH_KHR               0x9146
+#endif
+#ifndef GL_DEBUG_SEVERITY_MEDIUM_KHR
+#  define GL_DEBUG_SEVERITY_MEDIUM_KHR             0x9147
+#endif
+#ifndef GL_DEBUG_SEVERITY_LOW_KHR
+#  define GL_DEBUG_SEVERITY_LOW_KHR                0x9148
+#endif
+#ifndef GL_DEBUG_SEVERITY_NOTIFICATION_KHR
+#  define GL_DEBUG_SEVERITY_NOTIFICATION_KHR       0x826B
+#endif
+#endif /* HAS_GLES */
+
 #include <string_view>
 #include <utility>
 
