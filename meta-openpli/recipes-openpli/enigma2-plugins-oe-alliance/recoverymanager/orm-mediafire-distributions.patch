+/* The distribution of /etc/issue when it is one of them, enigma.info does not name these images. */
+static const char *custom_distro(void)
+{
+	char text[1024];
+	size_t length;
+	FILE *file = fopen("/etc/issue", "r");
+	if (!file)
+		return NULL;
+	length = fread(text, 1, sizeof(text) - 1, file);
+	fclose(file);
+	text[length] = '\0';
+	for (size_t i = 0; i < sizeof(mediafire_names) / sizeof(mediafire_names[0]); ++i)
+		if (strcasestr(text, mediafire_names[i]))
+			return mediafire_names[i];
+	return NULL;
+}
+
+static int mediafire_key(const char *name, char *key, size_t size)
+{
+	char model[32];
+	boxinfo_value("model", model, sizeof(model));
+	for (size_t i = 0; i < sizeof(mediafire_folders) / sizeof(mediafire_folders[0]); ++i) {
+		const struct mediafire_folder *f = &mediafire_folders[i];
+		if (!strcasecmp(f->name, name) && (!f->model || !strcmp(f->model, model))) {
+			snprintf(key, size, "%s", f->key);
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/* The text of the value of key in from..end, a string or a number. */
+static int json_field(const char *from, const char *end, const char *key, char *out, size_t size)
+{
+	char quoted[32];
+	const char *found;
+	struct json j;
+	snprintf(quoted, sizeof(quoted), "\"%s\"", key);
+	out[0] = '\0';
+	found = memmem(from, (size_t)(end - from), quoted, strlen(quoted));
+	if (!found)
+		return 0;
+	j.p = found + strlen(quoted);
+	j.end = end;
+	return eat(&j, ':') && read_scalar(&j, out, size);
+}
+
+/* The zips of this box in the MediaFire folder of the distribution, 0 for a folder that could not be read. */
+static int mediafire_images(const char *name, struct image *images, int *count)
+{
+	char key[32];
+	char url[256];
+	size_t length = 0;
+	char *text = NULL;
+	const char *end;
+	const char *p;
+	if (!mediafire_key(name, key, sizeof(key)))
+		return 1;  /* No folder for this box. */
+	snprintf(url, sizeof(url), MEDIAFIRE_API "%s", key);
+	unlink(FEED_FILE);
+	if (download_file(url, FEED_FILE, 30))
+		text = read_file(FEED_FILE, &length);
+	unlink(FEED_FILE);
+	if (!text)
+		return 0;
+	end = text + length;
+	p = memmem(text, length, "\"filename\"", 10);
+	while (p && *count < MAX_IMAGES) {
+		const char *next = memmem(p + 10, (size_t)(end - p - 10), "\"filename\"", 10);
+		const char *stop = next ? next : end;  /* The fields of this file, up to the next one. */
+		struct image *image = &images[*count];
+		char file[160];
+		char link[512];
+		char size[24];
+		if (json_field(p, stop, "filename", file, sizeof(file)) && is_image_archive(file) && for_box(file) &&
+			json_field(p, stop, "normal_download", link, sizeof(link)) && link[0]) {
+			memset(image, 0, sizeof(*image));
+			snprintf(image->category, sizeof(image->category), "%s", name);
+			snprintf(image->name, sizeof(image->name), "%s", file);
+			snprintf(image->link, sizeof(image->link), "%s", link);
+			if (json_field(p, stop, "size", size, sizeof(size)))
+				image->size = strtoll(size, NULL, 10);
+			(*count)++;
+		}
+		p = next;
+	}
+	free(text);
+	return 1;
+}
+
+/* The link of a file of MediaFire is its page, the download button of the page holds the link of the file. */
+static void mediafire_direct(const char *link, char *url, size_t size)
+{
+	size_t length = 0;
+	char *text = NULL;
+	const char *found;
+	snprintf(url, size, "%s", link);
+	if (!strstr(link, "mediafire.com"))
+		return;
+	unlink(MEDIAFIRE_PAGE);
+	if (download_file(link, MEDIAFIRE_PAGE, 30))
+		text = read_file(MEDIAFIRE_PAGE, &length);
+	unlink(MEDIAFIRE_PAGE);
+	if (!text)
+		return;
+	found = strstr(text, "href=\"https://download");
+	if (found) {
+		size_t n = strcspn(found + 6, "\"");
+		if (n + 1 < size) {
+			memcpy(url, found + 6, n);
+			url[n] = '\0';
+		}
+	}
+	free(text);
+}
