+/* The length of the extension of an image archive: .zip, or a tarball of the images that are not zipped. */
+static size_t archive_ext(const char *name)
+{
+	static const char *const extensions[] = {".zip", ".tar.bz2", ".tar.xz"};
+	size_t length = strlen(name);
+	for (size_t i = 0; i < sizeof(extensions) / sizeof(extensions[0]); ++i) {
+		size_t n = strlen(extensions[i]);
+		if (length > n && !strcasecmp(name + length - n, extensions[i]))
+			return n;
+	}
+	return 0;
+}
+
+static int is_tarball(const char *name)
+{
+	return archive_ext(name) > 4;
+}
+
+/* A zip or a tarball of an image; a plain rootfs tarball holds no kernel, ofgwrite cannot flash it alone. */
+static int is_image_archive(const char *name)
+{
+	return archive_ext(name) && (!is_tarball(name) || !strstr(name, ".rootfs."));
+}
