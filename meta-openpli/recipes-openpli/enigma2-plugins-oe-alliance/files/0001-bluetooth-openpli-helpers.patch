--- /dev/null
+++ b/DMBluetoothSetup/Compat.py
@@ -0,0 +1,36 @@
+"""Compatibility with OpenPLi and DreamOS helper modules."""
+try:
+    from Tools.Log import Log
+except ModuleNotFoundError as error:
+    if error.name != "Tools.Log":
+        raise
+
+    class Log:
+        @staticmethod
+        def d(message=""):
+            print("[BluetoothSetup][DEBUG] %s" % message)
+
+        @staticmethod
+        def i(message=""):
+            print("[BluetoothSetup][INFO] %s" % message)
+
+        @staticmethod
+        def w(message=""):
+            print("[BluetoothSetup][WARN] %s" % message)
+
+try:
+    from Tools.DreamboxHardware import getFPVersion as _getFPVersion
+except ModuleNotFoundError as error:
+    if error.name != "Tools.DreamboxHardware":
+        raise
+    from Tools.StbHardware import getFPVersion as _getFPVersion
+
+
+def getFPVersion():
+    # OpenPLi returns text, DreamOS can return a number.
+    value = _getFPVersion()
+    try:
+        return float(value)
+    except (TypeError, ValueError):
+        Log.w("Unable to determine frontprocessor version: %r" % value)
+        return None
